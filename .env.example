# ============================================
# HONEYPOT AUTH SYSTEM - EQUIPO DECEPTICONS
# ============================================

# Base de datos - PostgreSQL local
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/honeypot_db"

# Secreto sesiones - Cambiar en producción
SESSION_SECRET="genera_con: openssl rand -hex 32"

# Puerto aplicación
PORT=3000

# Modo desarrollo
NODE_ENV="development"